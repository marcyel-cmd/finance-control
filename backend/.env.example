# =============================================================
# .env.example — PrevÊ Finance Control — Backend
# Copie este arquivo para .env e preencha com seus valores reais
# =============================================================

# ── Banco de dados (PostgreSQL) ──────────────────────────────
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/financecontrol

# ── JWT (gere chaves fortes com: openssl rand -hex 32) ───────
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_FORTE_32_CHARS
JWT_REFRESH_SECRET=SUBSTITUA_POR_OUTRA_CHAVE_FORTE_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Servidor ─────────────────────────────────────────────────
PORT=3333
NODE_ENV=production

# ── CORS — URL pública do seu frontend ───────────────────────
# Exemplo: https://preve.seudominio.com.br
FRONTEND_URL=https://SEU_DOMINIO_AQUI

# ── WebAuthn (passkey/biometria) ─────────────────────────────
# RP_ID: domínio SEM protocolo (ex: preve.seudominio.com.br)
# ORIGIN: URL completa com protocolo (ex: https://preve.seudominio.com.br)
WEBAUTHN_RP_ID=SEU_DOMINIO_AQUI
WEBAUTHN_ORIGIN=https://SEU_DOMINIO_AQUI

# ── IA — Gemini (para importação de fatura por PDF/imagem) ───
# Obtenha em: https://aistudio.google.com/apikey
# Deixe vazio se não usar importação de faturas
GEMINI_API_KEY=

# ── Web Push (notificações nativas via PWA) ──────────────────
# Gere um par com: npx web-push generate-vapid-keys
# A pública vai pro frontend (não é segredo); a privada NUNCA pode vazar.
# Subject: mailto:seuemail@dominio.com (exigido pela spec do VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu_email@dominio.com
