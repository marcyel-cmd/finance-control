# Database — ajustar user/senha conforme seu PostgreSQL local
DATABASE_URL=postgresql://postgres:153@George@localhost:5432/financecontrol

# JWT — pode usar qualquer string em dev, mas se quiser gerar forte:
# openssl rand -hex 32
JWT_SECRET=dev-secret-qualquer-coisa-aqui-12345
JWT_REFRESH_SECRET=dev-refresh-outro-segredo-67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3333
NODE_ENV=development

# CORS — porta padrão do Vite
FRONTEND_URL=http://localhost:5173

# WebAuthn — em dev local
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# IA — opcional, só precisa se for testar importação de fatura
# Deixe vazio se não tiver, o resto funciona normal
ANTHROPIC_API_KEY=