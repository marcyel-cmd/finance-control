// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions       Transaction[]
  cards              CreditCard[]
  notifications      Notification[]
  passkeys           Passkey[]
  recurringTemplates RecurringTemplate[]

  @@map("users")
}

model CreditCard {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  name       String
  lastDigits String   @map("last_digits") @db.VarChar(4)
  brand      String
  color      String   @db.VarChar(7)
  limit      Decimal  @default(0) @db.Decimal(15, 2)
  used       Decimal  @default(0) @db.Decimal(15, 2)
  closingDay Int      @map("closing_day")
  dueDay     Int      @map("due_day")
  type       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]
  recurringTemplates RecurringTemplate[]

  @@map("credit_cards")
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  type          String
  description   String
  category      String
  value         Decimal  @db.Decimal(15, 2)
  date          DateTime
  paymentMethod String   @map("payment_method")
  cardId        String?  @map("card_id")
  status        String   @default("realizado")
  recurring     Boolean  @default(false)
  month         Int
  year          Int

  linkedPreviewId String? @map("linked_preview_id")

  installment       Boolean  @default(false)
  installmentTotal  Int?     @map("installment_total")
  installmentNumber Int?     @map("installment_number")
  parentId          String?  @map("parent_id")
  totalValue        Decimal? @map("total_value") @db.Decimal(15, 2)

  billMonth Int? @map("bill_month")
  billYear  Int? @map("bill_year")

  // Origem da transação se foi criada automaticamente por uma recorrência.
  // Null = lançada manualmente, importada ou via outras vias.
  recurringTemplateId String? @map("recurring_template_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  card              CreditCard?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  recurringTemplate RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)

  @@index([userId, month, year])
  @@index([userId, category])
  @@index([userId, type, status])
  @@index([userId, billMonth, billYear])
  @@index([cardId])
  @@index([cardId, billMonth, billYear])
  @@index([parentId])
  @@index([linkedPreviewId])
  @@index([recurringTemplateId, date])
  @@map("transactions")
}

model Category {
  id    String @id
  label String
  color String @db.VarChar(7)
  icon  String

  @@map("categories")
}

model Notification {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  type          String
  title         String
  message       String
  date          DateTime @db.Date
  read          Boolean  @default(false)
  icon          String
  actionLabel   String?  @map("action_label")
  actionRoute   String?  @map("action_route")
  actionDone    Boolean  @default(false) @map("action_done")
  relatedAmount Decimal? @map("related_amount") @db.Decimal(15, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Passkey {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  deviceName   String?   @map("device_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passkeys")
}

// Template que descreve uma transação recorrente.
// Um job diário cria as transações reais conforme a frequência aqui definida.
// Cria com status "pendente" — usuário confirma na home ou via notificação.
model RecurringTemplate {
  id            String  @id @default(uuid())
  userId        String  @map("user_id")
  type          String // entrada, saida
  description   String
  category      String
  value         Decimal @db.Decimal(15, 2)
  paymentMethod String  @map("payment_method")
  cardId        String? @map("card_id")

  // Cadência. Por enquanto: monthly (dayOfMonth), weekly (weekday), daily.
  frequency  String
  dayOfMonth Int?   @map("day_of_month") // 1-31, usado em monthly
  weekday    Int? // 0=domingo … 6=sábado, usado em weekly

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  active          Boolean   @default(true)
  // Marca o último dia (sem hora) em que o job gerou transação a partir deste template.
  // Combinado com o índice (recurringTemplateId, date) na Transaction garante idempotência.
  lastGeneratedAt DateTime? @map("last_generated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  card         CreditCard?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, active])
  @@map("recurring_templates")
}

model WebAuthnChallenge {
  id        String   @id @default(uuid())
  key       String   @unique
  challenge String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("webauthn_challenges")
}
