# ── URL da API do backend ─────────────────────────────────────
# Exemplo: https://api.seudominio.com.br/api/v1
#          ou https://seudominio.com.br/api/v1 (se usar proxy Nginx)
VITE_API_URL=https://SEU_DOMINIO_AQUI/api/v1
